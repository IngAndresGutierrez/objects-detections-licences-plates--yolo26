# Entorno virtual (Poetry lo crea en .venv por poetry.toml)
.venv/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Pesos descargados (yolo26n.pt, yoloe-26s-seg.pt) y encoder de texto de YOLOE (mobileclip2_b.ts)
/weights/
*.ts

# Pesos de entrenamiento: solo se versionan los best.pt de los runs finales
*.pt
!runs/yolo_scratch/train/*/weights/best.pt
!runs/yolo_pretrained/train/*/weights/best.pt

# Cachés de Ultralytics (contienen rutas absolutas)
*.cache
